{
  "name": "codex-pulse",
  "version": "0.1.0",
  "description": "精致的 Codex 桌面额度监视器",
  "author": "Codex Pulse",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "pack": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@openai/codex": "0.161.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.codexpulse.desktop",
    "productName": "Codex Pulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Codex-Pulse-${version}-Windows.exe"
    }
  }
}
